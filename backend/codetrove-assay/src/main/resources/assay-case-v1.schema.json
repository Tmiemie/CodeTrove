{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codetrove.local/schemas/assay-case-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_key", "description", "request", "assertions"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "case_key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,159}$" },
    "description": { "type": "string", "minLength": 1, "maxLength": 500 },
    "enabled": { "type": "boolean", "default": true },
    "timeout_ms": { "type": "integer", "minimum": 100, "maximum": 30000, "default": 5000 },
    "data_pre": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/preStep" }
    },
    "request": { "$ref": "#/$defs/request" },
    "mocks": {
      "type": "array",
      "maxItems": 20,
      "items": { "$ref": "#/$defs/mock" }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "$ref": "#/$defs/assertion" }
    }
  },
  "$defs": {
    "headers": {
      "type": "object",
      "maxProperties": 10,
      "additionalProperties": { "type": "string", "maxLength": 2000 }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "method", "path"],
      "properties": {
        "target": { "enum": ["application", "mock"] },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "path": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "headers": { "$ref": "#/$defs/headers" },
        "body": {}
      }
    },
    "preStep": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "type", "request", "save_as", "extract"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$" },
        "type": { "const": "http" },
        "request": { "$ref": "#/$defs/request" },
        "save_as": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,63}$" },
        "extract": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 20,
          "additionalProperties": { "type": "string", "pattern": "^\\$\\.(status|body(\\.[a-zA-Z0-9_-]+)*)$" }
        }
      }
    },
    "mock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "match", "respond", "expect_calls"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9_-]{0,63}$" },
        "type": { "const": "http" },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "path"],
          "properties": {
            "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
            "path": { "type": "string", "minLength": 1, "maxLength": 1000 }
          }
        },
        "respond": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": { "type": "integer", "minimum": 100, "maximum": 599 },
            "headers": { "$ref": "#/$defs/headers" },
            "body": {}
          }
        },
        "expect_calls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 0, "maximum": 100 },
            "max": { "type": "integer", "minimum": 0, "maximum": 100 }
          }
        }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "operator", "path"],
      "properties": {
        "type": { "const": "response" },
        "operator": { "enum": ["equals", "not_equals", "exists", "not_exists", "contains", "number_between", "array_size"] },
        "path": { "type": "string", "pattern": "^\\$\\.(status|body(\\.[a-zA-Z0-9_-]+)*)$" },
        "expected": {}
      }
    }
  }
}
