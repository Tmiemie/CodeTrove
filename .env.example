# Copy values into Windows user environment variables or an untracked .env file.
# Never commit real passwords or API keys.

CODETROVE_DB_URL=jdbc:mysql://127.0.0.1:3306/codetrove?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia%2FShanghai
CODETROVE_DB_USERNAME=codetrove_app
CODETROVE_DB_PASSWORD=replace-with-local-database-password

CODETROVE_REDIS_HOST=127.0.0.1
CODETROVE_REDIS_PORT=6379
CODETROVE_REDIS_PASSWORD=replace-with-local-redis-password

CODETROVE_KAFKA_PORT=9092
CODETROVE_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
CODETROVE_EVENTING_ENABLED=true
CODETROVE_CHECK_GATE_ENABLED=true
CODETROVE_OUTBOX_BATCH_SIZE=20
CODETROVE_OUTBOX_MAX_ATTEMPTS=8
CODETROVE_OUTBOX_POLL_INTERVAL_MS=1000
CODETROVE_KAFKA_SEND_TIMEOUT=10s
CODETROVE_CHECK_CONSUMER_GROUP=codetrove-check-v1
CODETROVE_CURATOR_CONSUMER_GROUP=codetrove-curator-v1
CODETROVE_CURATOR_ENABLED=true
CODETROVE_CURATOR_PARALLELISM=2
CODETROVE_CURATOR_SKILL_TIMEOUT=3s
CODETROVE_CURATOR_MAX_ATTEMPTS=2
CODETROVE_ASSAY_CONSUMER_GROUP=codetrove-assay-v1
CODETROVE_ASSAY_ENABLED=true
CODETROVE_ASSAY_TARGET_BASE_URL=http://127.0.0.1:18080

CODETROVE_SERVER_PORT=8080
CODETROVE_NODE_ID=1
CODETROVE_REPOSITORY_ROOT=./runtime/repositories
CODETROVE_REPOSITORY_MAX_INLINE_BLOB_BYTES=1048576
CODETROVE_MR_MAX_DIFF_FILES=200
CODETROVE_MR_MAX_FILE_PATCH_BYTES=262144
CODETROVE_MR_MAX_TOTAL_PATCH_BYTES=2097152
CODETROVE_GIT_TIMEOUT_SECONDS=60
CODETROVE_GIT_MAX_REQUEST_BYTES=115343360
CODETROVE_GIT_MAX_COMMAND_BYTES=1048576
CODETROVE_GIT_MAX_OBJECT_BYTES=20971520
CODETROVE_GIT_MAX_PACK_BYTES=104857600
CODETROVE_GIT_MAX_CONCURRENT_REQUESTS=8
CODETROVE_JWT_SECRET=replace-with-at-least-32-random-bytes

# Optional Docker MySQL for contributors without a local MySQL installation.
CODETROVE_MYSQL_PORT=3307
CODETROVE_MYSQL_ROOT_PASSWORD=replace-with-local-root-password
